{
  "name": "poids-plume",
  "version": "1.1.0",
  "description": "Compresseur de PDF hors ligne",
  "main": "src/main.js",
  "author": "Maxence",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "publier": "node outils/publier.js",
    "version-corrective": "npm version patch && git push --follow-tags",
    "version-mineure": "npm version minor && git push --follow-tags"
  },
  "build": {
    "appId": "fr.maxence.poidsplume",
    "productName": "Poids Plume",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icone.png"
    },
    "portable": {
      "artifactName": "Poids Plume ${version}.exe",
      "unicode": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Poids Plume",
      "artifactName": "Poids-Plume-Installateur-${version}.exe",
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  }
}
